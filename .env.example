# ── Authentication (NextAuth) ──────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without it getAuthSecret() returns undefined and the
# deployment does not come up — deliberately, because falling back to a known
# constant would make every session forgeable. Development uses a built-in
# insecure fallback, so this may be left blank locally.
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Alias for NEXTAUTH_SECRET, read only when that is unset. Set ONE of the two,
# not both. Present so an Auth.js-style configuration keeps working.
AUTH_SECRET=

# The deployment's own origin. Per-environment: localhost locally, the preview
# URL in staging, the real domain in production.
NEXTAUTH_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=docrud

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_TEST_MODE=true

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_NAME=Docrud
SMTP_FROM_EMAIL=noreply@example.com

# Signs the one-click unsubscribe links in bulk mail, so a recipient cannot
# unsubscribe somebody else by editing the URL. REQUIRED before sending bulk
# mail; unused if only transactional mail (OTP) is sent.
# Generate one with: openssl rand -hex 32
MAIL_UNSUBSCRIBE_SECRET=

# Verifies webhook callbacks from the mail provider (bounces, complaints,
# deliveries) so a forged POST cannot mark addresses as bounced. REQUIRED only
# if provider webhooks are configured; leave blank otherwise.
MAIL_PROVIDER_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=docrud
R2_PUBLIC_URL=https://your-r2-public-url.example.com

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_MIGRATION_SECRET=your_admin_migration_secret_here

# The account treated as the super-admin owner. Reported (as a boolean only,
# never the value) by /api/super-admin/integrations. OPTIONAL: leave blank
# unless super-admin bootstrap is wanted.
SUPER_ADMIN_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
# ── Job Scraper ────────────────────────────────────────────────────────────
# Public ATS job-board ingestion.
#
# Keep this FALSE in .env.example/local development unless you intentionally
# want to run the scraper. Enable it in Vercel Production.
#
# General format:
#   slug
#   slug|Display Name
#   slug|Display Name|IN
#
# The third field is the ISO country code used by the source registry.

JOB_SCRAPER_ENABLED=

# Greenhouse
GREENHOUSE_BOARDS=razorpaysoftwareprivatelimited|Razorpay|IN,groww|Groww|IN,druva|Druva|IN,postman|Postman|IN

# Lever
LEVER_COMPANIES=mindtickle|MindTickle|IN

# Ashby
ASHBY_JOB_BOARDS=atlan|Atlan|IN

# Workday
# Format:
# tenant:shard:site|Display Name|IN
#
# Example:
# WORKDAY_BOARDS=example:wd5:Careers|Example Company|IN
WORKDAY_BOARDS=

# SmartRecruiters
# Format:
# companyIdentifier|Display Name|IN
SMARTRECRUITERS_COMPANIES=

# Workable
# Format:
# accountSlug|Display Name|IN
WORKABLE_COMPANIES=

# Recruitee
# Format:
# companySlug|Display Name|IN
RECRUITEE_COMPANIES=

# Personio
# Format:
# companySlug|Display Name|IN
PERSONIO_COMPANIES=

# BambooHR
# Format:
# companySlug|Display Name|IN
BAMBOOHR_COMPANIES=

# ── Microsoft Careers (Eightfold) ────────────────────────────────────────────
# Format: <eightfold-domain>|<Display Name>|<country>
# The slug is the Eightfold DOMAIN sent as a query parameter; the host is a
# fixed literal in code and cannot be changed by configuration.
# Permitted by https://apply.careers.microsoft.com/robots.txt, which Disallows
# everything except a named list that includes /api/pcsx.
# MICROSOFT_CAREERS=microsoft.com|Microsoft|IN
MICROSOFT_CAREERS=
# Search pages per run (10 results per page — the server ignores larger sizes).
# 2,215 jobs is ~222 pages, so one run reads a SLICE and resumes next run.
MICROSOFT_MAX_PAGES=10
# Parallel detail requests. Kept deliberately small: this is someone else's site.
MICROSOFT_CONCURRENCY=2
# Pause between search pages, so pagination is never a burst.
MICROSOFT_MIN_INTERVAL_MS=250
# Descriptions fetched per run. 0 disables detail fetching entirely.
MICROSOFT_DETAIL_LIMIT=100

# ── Ingestion candidate lookup (scale) ──────────────────────────────────
# How ingestion finds the postings a source might already have stored.
# Server-side only: no query string, header or body can select it.
#
#   unset / anything but "true"  ->  whole-corpus load   (DEFAULT)
#   "true"                       ->  per-source candidate lookup
#
# The default loads every posting so the planner can index it by identity.
# Measured: ~61 MB of heap at today's 5,276 postings, but 733 MB at 100,000 --
# against a 1,024 MB serverless limit. The incremental path queries only the
# postings each source's drafts could match, using the existing
# `ingest_identity` index, so its cost tracks the jobs FETCHED rather than the
# corpus size.
#
# Left OFF until a staged rollout confirms it in production. The two paths are
# proven to produce byte-identical corpora by
# scripts/ingest-incremental-equivalence.selftest.ts (npm run
# test:ingest-incremental-equivalence).
INGEST_INCREMENTAL_LOOKUP=

# ── Per-source rate / concurrency overrides ──────────────────────────────────
# JOB_SOURCE_CONFIG tunes an INDIVIDUAL source without a code change. Format is
# comma-separated `sourceId=key:value;key:value` entries, where sourceId is the
# registry name (e.g. "greenhouse:postman", "workday:erm:ERM_Careers").
#
#   enabled                          "false" disables the source. It can only
#                                    turn a source OFF — never silently on.
#   minIntervalMs                    minimum gap between requests (default 1000)
#   concurrency                      parallel requests (default 1)
#   timeoutMs                        per-request timeout (default 20000)
#   maxAttempts                      retries before failing (default 3)
#   disableAfterConsecutiveFailures  auto-disable threshold (default 10)
#
# Unknown keys are IGNORED rather than rejected, so a typo cannot take the whole
# registry down. Raise concurrency only where the source's own published limits
# permit it — the conservative defaults exist to stay a well-behaved client.
#
#   JOB_SOURCE_CONFIG=greenhouse:postman=minIntervalMs:2000;concurrency:1
JOB_SOURCE_CONFIG=

# Optional Workday description-detail backfill.
# Leave unset unless intentionally enabling additional per-job requests.
# WORKDAY_DETAIL_LIMIT=

# Optional SmartRecruiters description-detail backfill.
# Leave unset unless intentionally enabling additional per-job requests.
# SMARTRECRUITERS_DETAIL_LIMIT=


# Microsoft Clarity project id. Leave empty to disable Clarity entirely.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Scheduled jobs (cron) ──────────────────────────────────────────────────
# Shared secret for /api/cron/* endpoints. Vercel Cron sends it automatically
# as `Authorization: Bearer <CRON_SECRET>` once this is set in the project's
# environment variables. Without it, scheduled mail will not run in production.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ── Redis (distributed cache) ──────────────────────────────────────────────
# OPTIONAL. With both blank the app behaves exactly as it does without Redis:
# the in-process cache and MongoDB serve every request. Redis only adds a cache
# shared BETWEEN serverless instances, so a corpus read paid by one lambda is
# reused by the rest and an invalidation is seen by all of them.
#
# Upstash REST credentials (Vercel -> Integrations -> Upstash). Server-only —
# never prefix these NEXT_PUBLIC_, they are credentials. Real values belong in
# Vercel's environment settings, never in this file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Public jobs read source (Phase 2.5/2.6/2.7E) ─────────────────────────────
# GET /api/jobs/public always reads `hiring_jobs`. The source is NOT selectable
# — not by env var, and not by query string, header or request body.
#
# JOB_READ_FROM_HIRING_JOBS is RETIRED and has NO effect. It is deliberately
# absent below; setting it anywhere (including Vercel) changes nothing. It is
# documented here only so an operator who finds it still set in an existing
# environment knows it is inert and can remove it.
#
# Why it is ignored rather than honoured: Phase 2.6+2.7E made hiring_jobs
# canonical and removed the app_state job write. The app_state job document
# still exists in production but has been FROZEN since cutover — no create,
# edit, unpublish or deletion has reached it. Honouring `false` would therefore
# serve a corpus that silently stopped changing, which is worse than an error
# because nothing surfaces it. A flag pointing at a dead store is not a
# rollback. See lib/server/db/public-jobs-source.ts.
#
# Rolling back to app_state is no longer a flag flip: app_state must be
# re-materialised first (scripts/db-rebalance-job-order.mjs, 2.7D rollback
# contract) before any read could safely be pointed back at it.

# Fraction of /api/jobs/public requests that ALSO read the other store and
# compare the two, logging "[jobs:public] DUAL-READ MISMATCH" on disagreement.
# A fraction, not a percentage: 1 = 100%, 0.05 = 5%. Out-of-range or malformed
# values disable it. A sampled request costs roughly double the database work,
# so 1 is for a low-traffic staging environment only.
#
#   staging     JOB_READ_VERIFY_SAMPLE=1
#   production  JOB_READ_VERIFY_SAMPLE=0.05
JOB_READ_VERIFY_SAMPLE=0

# ── Recommendation read source (Phase 3.5) ───────────────────────────────────
# Whether GET /api/recommendations/jobs answers from the precomputed store in
# `recommendation_results` or recomputes the ranking on the request.
#
#   unset / anything but "true"  ->  LIVE, recomputed  (DEFAULT, and the rollback)
#   "true"                       ->  serve stored results
#
# Exactly the string "true" enables it. "TRUE", "1", empty and absent are all
# OFF, so a malformed value fails to the path that has been serving production
# all along. Server-side only: no query string, header or body can select it.
#
# WHAT CHANGES WHEN IT IS ON: the stored ranking is read first, and only the
# postings it names are fetched by _id — the ~5,279-posting corpus read is
# skipped. Cards are rebuilt from the CURRENT postings, so only the ranking is
# remembered, never the job text. Every uncertainty (stale versions, no record,
# signed-out viewer, storage failure, vanished postings) falls back to LIVE; a
# storage outage never becomes an empty "you match nothing" response.
#
# NOT AFFECTED: the personalized feed. It excludes applied jobs and carries ATS
# results, both of which change without the profile or job corpus changing, so
# a stored copy cannot be proven current. It stays request-time either way.
#
# ROLLOUT: leave absent/false for the first deploy. The scheduler must have run
# (see CRON_SECRET) or every request simply falls back to LIVE. Turn it on in
# staging first; rollback is this variable alone, effective on the next request.
RECOMMENDATION_READ_FROM_PRECOMPUTED=false
