# Timer for docrud-cron@recommendations.service — schedule mirrored from ops/cron/jobs.conf.
# scripts/cron-scheduler.selftest.ts fails if the two ever disagree.
[Unit]
Description=DoCrud cron timer: recommendations (Recompute stale job recommendations)
Documentation=file:/home/ubuntu/docrud/ops/README.md

[Timer]
Unit=docrud-cron@recommendations.service
OnCalendar=*:0/5
# All schedules are UTC so they do not shift with server locale or DST.
Persistent=false
# Spreads load so two jobs never start on the same second.
RandomizedDelaySec=45s
AccuracySec=1s

[Install]
WantedBy=timers.target
