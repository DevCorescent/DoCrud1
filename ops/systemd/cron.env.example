# TEMPLATE for /etc/docrud/cron.env — DO NOT PUT A REAL SECRET IN THIS FILE.
#
# This example is committed; the real file is not, and lives outside the
# repository at /etc/docrud/cron.env with root:root ownership and mode 0600.
# systemd reads it as root before dropping to User=ubuntu, so the application
# user never needs read access to the secret file itself.
#
# Install:
#   sudo install -d -m 0755 -o root -g root /etc/docrud
#   sudo install -m 0600 -o root -g root /dev/null /etc/docrud/cron.env
#   sudo -e /etc/docrud/cron.env          # paste the line below, with the real value
#
# CRON_SECRET must be byte-identical to the value the Next.js process is
# running with (PM2's environment). A mismatch shows up as HTTP 401 in the
# journal; the app reporting 503/400 instead means the APP has no CRON_SECRET.

CRON_SECRET=replace-me-with-the-value-from-the-pm2-environment

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# Where the Next.js server listens locally. Never set this to the public URL:
# cron traffic should not leave the box or traverse nginx.
#DOCRUD_CRON_BASE_URL=http://127.0.0.1:3000

# The public host the app should believe it is serving. Used to reconstruct the
# X-Forwarded-* pair that nginx would normally add, so that links generated
# inside emails point at the real site rather than 127.0.0.1. See the comment
# block in ops/cron/run-cron-job.sh.
#DOCRUD_PUBLIC_HOST=www.docrud.com
#DOCRUD_PUBLIC_PROTO=https
