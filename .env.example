# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=docrud

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_TEST_MODE=true

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_NAME=Docrud
SMTP_FROM_EMAIL=noreply@example.com

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=docrud
R2_PUBLIC_URL=https://your-r2-public-url.example.com

# Admin
ADMIN_MIGRATION_SECRET=your_admin_migration_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

 NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_keywq
# ── Job Scraper — approved India-focused public ATS sources ──────────────
# All optional. Each is a comma list of public job-board identifiers; entries may
# be "slug", "slug|Display Name", or "slug|Display Name|IN" (3rd field = ISO country).
# Only these fixed provider hosts are ever contacted (SSRF allowlist) — never a
# browser-supplied URL. Leave blank to disable a provider. Expand the registry by
# adding more approved boards here; do NOT hardcode a giant list in code.
#   JOB_SCRAPER_ENABLED=false   # kill switch (default: enabled)
#   ASHBY_JOB_BOARDS=razorpay|Razorpay|IN,zepto|Zepto|IN     # api.ashbyhq.com
#   LEVER_COMPANIES=company-slug|Company|IN                  # api.lever.co
#   GREENHOUSE_BOARDS=board-token|Company|IN                 # boards-api.greenhouse.io
JOB_SCRAPER_ENABLED=
ASHBY_JOB_BOARDS=
LEVER_COMPANIES=
GREENHOUSE_BOARDS=
