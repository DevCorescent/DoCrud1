NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# MongoDB connection (required for database persistence)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=docrud
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-anon-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Razorpay configuration (REQUIRED for payments)
# Replace with your actual Razorpay key values
# Razorpay credentials (LIVE)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_SYK09bM68ilwIh
RAZORPAY_KEY_ID=rzp_live_SYK09bM68ilwIh
RAZORPAY_KEY_SECRET=OFldUWtld1uDg3QwI6EJFAHk
# Set to true for test mode, false for live mode
RAZORPAY_TEST_MODE=false

# SMTP / Email configuration
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=support@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Your App Name
SMTP_FROM_EMAIL=support@yourdomain.com

# Cloudflare R2 — file storage for uploads, images, videos, documents
# Get these from Cloudflare Dashboard → R2 → Manage API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public URL of your R2 bucket (custom domain or *.r2.dev URL)
R2_PUBLIC_URL=https://your-bucket.your-account.r2.dev
