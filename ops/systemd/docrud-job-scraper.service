# DoCrud job scraper — the ingestion worker.
#
# ═══ WHY THIS IS NOT A docrud-cron@ INSTANCE ═══
#
# Every job in ops/cron/jobs.conf is an HTTP call to a route that does the work
# inside the request. The scraper is the one job that must NOT be shaped that
# way: a full run over the configured boards exceeds nginx's proxy_read_timeout
# (60 s in production), and the route's own 300 s ceiling forces it to hand the
# source loop a deadline that a large corpus load can consume entirely — which
# is how a run came to report "0 discovered, 0 failed" having contacted nothing.
#
# So this unit runs the pipeline DIRECTLY, as a process. No proxy in front of
# it, no request ceiling, no deadline. That removes both failure modes at once
# rather than tuning a timeout that will be wrong again at the next scale.
#
# OVERLAP: Type=oneshot stops systemd starting a second copy while the first
# runs. That covers the timer, but NOT a Super Admin triggering a run from the
# browser at the same moment — a different process entirely — so the worker
# also takes the durable Mongo lease in lib/server/job-sources/run-lock.ts.
# systemd's guard and the lease cover different races; both are needed.
[Unit]
Description=DoCrud job scraper (public ATS ingestion)
Documentation=file:/home/ubuntu/docrud/ops/README.md
# The scraper calls third-party ATS APIs, so this is about real outbound
# connectivity, not just boot ordering.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/docrud

# ═══ NO EnvironmentFile — DELIBERATELY ═══
#
# The obvious line here is `EnvironmentFile=/home/ubuntu/docrud/.env`, and it is
# wrong twice over.
#
#  1. systemd's parser is NOT dotenv's. It requires every line to be KEY=VALUE,
#     treats an unquoted `#` as starting a comment MID-LINE, and fails the unit
#     on anything it cannot parse. The application's .env contains inline
#     comments and free prose, so systemd would either refuse to start the
#     service or — worse — truncate a value at a `#` and hand the worker a
#     silently corrupted MONGODB_URI.
#
#  2. Even parsed perfectly it would be the WRONG precedence. Next.js applies
#     .env.local over .env.<NODE_ENV> over .env; a single EnvironmentFile
#     reproduces none of that, so the worker could scrape a different set of
#     boards than the dashboard displays.
#
# Instead the worker calls @next/env's own loadEnvConfig (scripts/load-env.ts),
# which is the exact function the Next.js server uses. Parity is by
# construction, and no secret is ever copied into a unit file, into the journal
# or into the process argument list.
#
# NODE_ENV is set here because it SELECTS which env files are loaded. Without
# it the worker would resolve .env.development on a production host.
Environment=NODE_ENV=production
# WorkingDirectory above is what loadEnvConfig resolves .env* against, so it
# must stay the repository root.
ExecStart=/usr/bin/env npx tsx scripts/run-job-scraper.ts --trigger timer

# Exit 4 means "another run holds the lease". That is the lock working as
# designed, not a failure, so it must not mark the unit failed and must not
# raise an alert.
SuccessExitStatus=0 4

# ═══ WHY Restart=no, DESPITE "restart on unexpected failure" ═══
#
# For a Type=oneshot job driven by a timer, the NEXT TICK is the retry, and it
# is a better one than systemd's. A scraper failure is almost always a provider
# outage, an Atlas blip, or a bad configuration — none of which are fixed by
# trying again three seconds later, and all of which are made worse by it:
# restarting in place hammers a third party that is already returning errors,
# and repeated restarts would hold or churn the Mongo lease.
#
# Restart=on-failure would also fight the lease: a restarted copy would exit 4
# ("already running") until the previous lease expired, filling the journal with
# failures that are not failures.
#
# So the retry policy is the timer's cadence, deliberately. RestartSec is set
# only so that an operator who overrides this to on-failure for debugging does
# not get a tight loop by default.
Restart=no
RestartSec=60

# ═══ SHUTDOWN ═══
#
# The worker installs SIGTERM/SIGINT handlers that RELEASE the Mongo lease
# before exiting. KillMode=mixed sends SIGTERM to the main process only, giving
# that handler a chance to run, rather than signalling every process in the
# cgroup at once (which would kill the npx/tsx wrapper out from under it and
# strand the lease for the full 15-minute TTL).
KillMode=mixed
# Long enough for the release round-trip to Atlas, short enough that a stop does
# not hang. SIGKILL follows if the handler does not finish.
TimeoutStopSec=30
# Generous: a cold run over every board, plus the corpus load and the write.
# Shorter than the lease TTL (15 min) so systemd never kills a run that still
# believes it holds the lease.
TimeoutStartSec=840

# ── Hardening ───────────────────────────────────────────────────────────────
# Deliberately lighter than docrud-cron@.service: this one runs Node, needs
# outbound TLS to the ATS providers and to MongoDB Atlas, and needs to read the
# application tree.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The app lives under /home, so ProtectHome=read-only would make it unreadable.
ProtectHome=no
# Next.js and tsx both write caches inside the project directory.
ReadWritePaths=/home/ubuntu/docrud
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
