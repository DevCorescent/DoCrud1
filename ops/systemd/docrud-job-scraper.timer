# Timer for docrud-job-scraper.service.
#
# ═══ WHY 30 MINUTES AND NOT 5 ═══
#
# The measured local run over 7 sources fetches ~1,697 postings in ~13 s of
# provider time, but a production run also loads the corpus, plans, upserts and
# mirrors — minutes, not seconds — and that cost grows with both the number of
# boards and the size of the corpus. A 5-minute tick would spend most of its
# life colliding with the previous run and being dropped, which hides how long
# runs actually take.
#
# ═══ THIS CADENCE IS PROVISIONAL AND MUST BE MEASURED ═══
#
# 30 minutes is a STARTING POINT chosen to be safely longer than any plausible
# run — it is NOT a measured value, because no full production run has completed
# yet. Do not treat it as tuned.
#
# Before enabling this timer, complete one controlled manual run and read its
# real duration:
#
#   npx tsx scripts/run-job-scraper.ts --trigger manual
#   journalctl -u docrud-job-scraper.service | grep 'event=complete'
#
# Then set the interval to comfortably exceed the observed `durationMs` — a
# rule of thumb is at least 3x, so a normal run never approaches the next tick.
# If runs turn out to take minutes, 30 minutes is right; if they take longer
# than ~10 minutes, lengthen this rather than relying on the lease to absorb
# the overlap. Overlap IS prevented (Type=oneshot plus the Mongo lease), but a
# tick that is routinely skipped hides how long runs actually take.
[Unit]
Description=DoCrud job scraper timer (public ATS ingestion, every 30 minutes)
Documentation=file:/home/ubuntu/docrud/ops/README.md

[Timer]
Unit=docrud-job-scraper.service
# UTC, like every other schedule here, so it does not shift with locale or DST.
OnCalendar=*:0/30
# Catch up ONE missed run after downtime. The scrape is idempotent by identity,
# and a corpus that went stale during an outage should refresh on boot rather
# than wait for the next half hour.
Persistent=true
# Keeps the scraper off the same second as the :00/:30 cron ticks, so a heavy
# run does not start alongside the mail and recommendation passes.
RandomizedDelaySec=120s
AccuracySec=10s

[Install]
WantedBy=timers.target
